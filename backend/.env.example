# MTALI AGRO - Example environment variables for production
# Copy to `.env` and fill values before deploying.

# Django core
DJANGO_SECRET_KEY=your-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (either set full DATABASE_URL or individual DB_* values)
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# Email / notifications
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_NOTIFY_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# JWT / auth
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cloudinary (project already includes cloudinary apps)
# Either set CLOUDINARY_URL or individual vars
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limits (DRF)
DRF_ANON_RATE=60/min
DRF_USER_RATE=1000/hour
DRF_AUTH_RATE=5/min
DRF_CONTACT_RATE=5/min

# Optional: use a Render/Postgres connection string
# RENDER_EXTERNAL_URL or other platform-specific vars can be set by the host
